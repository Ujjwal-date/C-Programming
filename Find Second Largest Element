#include <stdio.h>

void main()
{
    int a[100], n, i;
    int largest, second;

    printf("Enter array size: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    largest = second = -2147483647;

    for(i = 0; i < n; i++)
    {
        if(a[i] > largest)
        {
            second = largest;
            largest = a[i];
        }
        else if(a[i] > second && a[i] != largest)
        {
            second = a[i];
        }
    }

    if(second == -2147483647)
        printf("Second largest does not exist");
    else
        printf("Second largest = %d", second);
}
