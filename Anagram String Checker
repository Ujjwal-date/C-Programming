#include <stdio.h>
#include <string.h>

void main()
{
    char a[100], b[100];
    int count[256] = {0};
    int i, flag = 1;

    printf("Enter first string: ");
    scanf("%99s", a);

    printf("Enter second string: ");
    scanf("%99s", b);

    if(strlen(a) != strlen(b))
        flag = 0;

    else
    {
        for(i = 0; a[i] != '\0'; i++)
        {
            count[(unsigned char)a[i]]++;
            count[(unsigned char)b[i]]--;
        }

        for(i = 0; i < 256; i++)
        {
            if(count[i] != 0)
                flag = 0;
        }
    }

    if(flag)
        printf("Anagram Strings");
    else
        printf("Not Anagram Strings");
}
