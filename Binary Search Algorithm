#include <stdio.h>

void main()
{
    int a[100], n, key;
    int low, high, mid, i;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter sorted elements:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element to search: ");
    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(a[mid] == key)
            break;

        else if(a[mid] < key)
            low = mid + 1;

        else
            high = mid - 1;
    }

    if(low <= high)
        printf("Element found at position %d", mid + 1);
    else
        printf("Element not found");
}
