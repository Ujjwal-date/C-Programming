#include <stdio.h>

int fibonacci(int n)
{
    if(n == 0)
        return 0;

    if(n == 1)
        return 1;

    return fibonacci(n - 1) + fibonacci(n - 2);
}

void main()
{
    int n, i;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    if(n < 0 || n > 40)
    {
        printf("Enter terms between 0 and 40");
        return;
    }

    for(i = 0; i < n; i++)
        printf("%d ", fibonacci(i));
}
