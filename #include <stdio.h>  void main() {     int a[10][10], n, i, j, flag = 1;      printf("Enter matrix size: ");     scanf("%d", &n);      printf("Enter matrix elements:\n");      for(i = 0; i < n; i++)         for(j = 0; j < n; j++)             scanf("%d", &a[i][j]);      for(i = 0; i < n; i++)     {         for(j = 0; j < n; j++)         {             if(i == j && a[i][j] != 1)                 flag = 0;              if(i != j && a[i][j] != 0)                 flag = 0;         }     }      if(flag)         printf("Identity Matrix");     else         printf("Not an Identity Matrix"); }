#include <stdio.h>

void main()
{
    char str[200];
    int i;

    printf("Enter a string:\n");
    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'a' && str[i] <= 'z')
            str[i] = str[i] - 32;
    }

    printf("Uppercase String: %s", str);
}
