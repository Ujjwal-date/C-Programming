#include <stdio.h>

struct student
{
    char name[40];
    int roll;
    float marks;
};

void main()
{
    struct student s[50], temp;
    int n, i, j;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter roll, name and marks:\n");
        scanf("%d %39s %f",
              &s[i].roll, s[i].name, &s[i].marks);
    }

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(s[j].marks < s[j + 1].marks)
            {
                temp = s[j];
                s[j] = s[j + 1];
                s[j + 1] = temp;
            }
        }
    }

    printf("\nSTUDENT RANKING\n");

    for(i = 0; i < n; i++)
    {
        printf("\nRank: %d", i + 1);
        printf("\nName: %s", s[i].name);
        printf("\nMarks: %.2f\n", s[i].marks);
    }
}
