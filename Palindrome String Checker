#include <stdio.h>
#include <string.h>

void main()
{
    char str[100];
    int i, length, flag = 1;

    printf("Enter a string: ");
    scanf("%99s", str);

    length = strlen(str);

    for(i = 0; i < length / 2; i++)
    {
        if(str[i] != str[length - i - 1])
        {
            flag = 0;
            break;
        }
    }

    if(flag)
        printf("Palindrome String");
    else
        printf("Not a Palindrome String");
}
