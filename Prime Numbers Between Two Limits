#include <stdio.h>

void main()
{
    int start, end, i, j, flag;

    printf("Enter starting and ending numbers: ");
    scanf("%d%d", &start, &end);

    for(i = start; i <= end; i++)
    {
        if(i < 2)
            continue;

        flag = 1;

        for(j = 2; j * j <= i; j++)
        {
            if(i % j == 0)
            {
                flag = 0;
                break;
            }
        }

        if(flag)
            printf("%d ", i);
    }
}
