#include <stdio.h>

void main()
{
    int a[10][10], n, i, j;
    int primary = 0, secondary = 0;

    printf("Enter matrix size: ");
    scanf("%d", &n);

    printf("Enter matrix elements:\n");

    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for(i = 0; i < n; i++)
    {
        primary += a[i][i];
        secondary += a[i][n - 1 - i];
    }

    printf("Primary diagonal sum = %d\n", primary);
    printf("Secondary diagonal sum = %d\n", secondary);
}
